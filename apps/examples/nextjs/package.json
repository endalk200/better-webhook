		"format:check": "biome check .",
		"format:write": "biome check --write ."
	},
	"dependencies": {
		"@better-webhook/core": "workspace:*",
		"@better-webhook/github": "workspace:*",
		"@better-webhook/nextjs": "workspace:*",
		"@better-webhook/otel": "workspace:*",
		"@better-webhook/stripe": "workspace:*",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
		"@opentelemetry/resources": "^2.2.0",
		"@opentelemetry/sdk-node": "^0.220.0",
		"next": "^16.2.10",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@better-webhook/biome-config": "workspace:*",
		"@better-webhook/typescript-config": "workspace:*",
		"@types/node": "^26.1.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"tsx": "^4.23.0",
		"typescript": "6.0.3"
