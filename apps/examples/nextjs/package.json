{
	"name": "@better-webhook/example-nextjs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev --hostname 127.0.0.1 --port ${PORT:-3001}",
		"build": "next build",
		"check-types": "next typegen && tsc --noEmit",
		"lint": "biome lint .",
